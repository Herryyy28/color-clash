# Format for Ad Unit IDs uses '/': ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
# Set VITE_ADMOB_IS_TESTING to "false" only for live production releases.
# =========================================================================
VITE_ADMOB_APP_ID="ca-app-pub-3940256099942544~3347511713"
VITE_ADMOB_REWARDED_ID="ca-app-pub-3940256099942544/5224354917"
VITE_ADMOB_INTERSTITIAL_ID="ca-app-pub-3940256099942544/1033173712"
VITE_ADMOB_BANNER_ID="ca-app-pub-3940256099942544/6300978111"
VITE_ADMOB_IS_TESTING="true"

# Android Release Versioning (Used in android/app/build.gradle)
VERSION_CODE="1"
VERSION_NAME="1.0.0"
